<Window x:Class="gisappwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIS空间数据工程管理系统" Height="768" Width="1366"
        WindowState="Maximized">

    <Grid Background="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2B579A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="武汉大学地图生产地理空间数据工程" Foreground="White" FontSize="20" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <Button x:Name="BtnPan" Content="🖐 平移" Width="70" Height="32" Margin="5,0" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnPan_Click"/>
                    <Button x:Name="BtnZoomIn" Content="🔍 放大" Width="70" Height="32" Margin="5,0" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnZoomIn_Click"/>
                    <Button x:Name="BtnZoomOut" Content="🔎 缩小" Width="70" Height="32" Margin="5,0" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnZoomOut_Click"/>
                    <Button x:Name="BtnFullExtent" Content="🌍 全图" Width="70" Height="32" Margin="5,0" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnFullExtent_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <WindowsFormsHost x:Name="tocHost" Margin="5" />
            </Border>

            <Border Grid.Column="1" Background="#E5E5E5" Margin="2">
                <WindowsFormsHost x:Name="mapHost" />
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="查询条件" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="建筑名称:"/>
                    <TextBox x:Name="txtSearchName" Margin="0,5,0,10" Height="25" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnSearch" Content="查询" Background="#2B579A" Foreground="White" Height="30" BorderThickness="0" Cursor="Hand" Click="BtnSearch_Click"/>

                    <TextBlock Text="详细信息" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Border BorderBrush="#EEE" BorderThickness="1" Background="#F9F9F9" CornerRadius="3">
                        <ListView x:Name="lstAttributes" Height="400" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="属性项" DisplayMemberBinding="{Binding Key}" Width="100"/>
                                    <GridViewColumn Header="属性值" DisplayMemberBinding="{Binding Value}" Width="150"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatusBar" Text="坐标系: CGCS2000 / Gauss-Kruger 3度带" VerticalAlignment="Bottom" Margin="10" Foreground="#333"/>

                <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="5" Margin="5">
                    <ScrollViewer>
                        <TextBlock Text="[10:30:12] 系统启动成功..." Foreground="#666" Margin="5"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>