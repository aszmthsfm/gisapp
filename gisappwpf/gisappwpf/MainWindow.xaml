<Window x:Class="gisappwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIS空间数据工程管理系统" Height="768" Width="1366"
        WindowState="Maximized"
        Background="#F4F7FB">

    <Window.Resources>
        <SolidColorBrush x:Key="WHU_Green" Color="#004B3B"/>

        <Style x:Key="TopToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A6B59"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003328"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource WHU_Green}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/whu_logo.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="GIS空间数据工程管理系统" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,40,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="BtnAddShapefile" Content="➕ 添加图层" Style="{StaticResource TopToolButtonStyle}" Click="BtnAddShapefile_Click"/>
                    <Button x:Name="BtnRemoveLayer" Content="➖ 移除图层" Style="{StaticResource TopToolButtonStyle}" Click="BtnRemoveLayer_Click"/>
                    <!--<Button x:Name="BtnExportMap" Content="💾 导出地图" Style="{StaticResource TopToolButtonStyle}" Click="BtnExportMap_Click"/>-->

                    <Rectangle Width="1" Height="24" Fill="#337868" Margin="10,0"/>
                    <Button x:Name="BtnPan" Content="🖐 平移" Style="{StaticResource TopToolButtonStyle}" Click="BtnPan_Click"/>
                    <Button x:Name="BtnZoomIn" Content="🔍 放大" Style="{StaticResource TopToolButtonStyle}" Click="BtnZoomIn_Click"/>
                    <Button x:Name="BtnZoomOut" Content="🔎 缩小" Style="{StaticResource TopToolButtonStyle}" Click="BtnZoomOut_Click"/>
                    <Button x:Name="BtnFullExtent" Content="🌍 全图" Style="{StaticResource TopToolButtonStyle}" Click="BtnFullExtent_Click"/>

                    <Rectangle Width="1" Height="24" Fill="#337868" Margin="10,0"/>

                    <Button x:Name="btnDrawRect" Content="⬜ 矩形选择" Style="{StaticResource TopToolButtonStyle}" Click="btnDrawRect_Click"/>
                    <Button x:Name="btnDrawPolygon" Content="🛑 多边形选择" Style="{StaticResource TopToolButtonStyle}" Click="btnDrawPolygon_Click"/>
                    <Button x:Name="btnOpenSpatialQuery" Content="🗺️ 按位置选择" Style="{StaticResource TopToolButtonStyle}" Click="btnOpenSpatialQuery_Click"/>
                    <Button x:Name="btnOpenAdvancedQuery" Content="⚙️ SQL属性查询" Style="{StaticResource TopToolButtonStyle}" Click="btnOpenAdvancedQuery_Click"/>

                    <Rectangle Width="1" Height="24" Fill="#337868" Margin="10,0"/>
                    <Button x:Name="btnClearSelect" Content="❌ 清除选择/重置" Style="{StaticResource TopToolButtonStyle}" Click="btnClearSelect_Click" Foreground="#FFD7D7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
                        <TextBlock Text="图层管理 (TOC)" VerticalAlignment="Center" Margin="15,0" FontWeight="SemiBold" Foreground="#444"/>
                    </Border>

                    <ListBox x:Name="lstLayers" Grid.Row="1" Margin="10" BorderThickness="1" BorderBrush="#E0E5EB" Background="White"
                             SelectionChanged="lstLayers_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="5,4" CornerRadius="3" Margin="5,2">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="📊 查看属性表" Click="MenuItem_ViewAttributes_Click"/>
                                                        <MenuItem Header="🎨 更改符号颜色" Click="MenuItem_StyleChange_Click"/>
                                                        <Separator />
                                                        <MenuItem Header="🔍 缩放至图层" IsEnabled="False"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#D6E4F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="26"/>
                                     
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,8,0" Click="LayerVisibility_Click" Tag="{Binding}"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Binding SymbolColor}" BorderBrush="#999">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Width" Value="14"/>
                                                <Setter Property="Height" Value="14"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="CornerRadius" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShapeType}" Value="Point">
                                                        <Setter Property="CornerRadius" Value="7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShapeType}" Value="Polyline">
                                                        <Setter Property="Height" Value="4"/>
                                                        <Setter Property="Width" Value="18"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                   

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E5E9ED" ShowsPreview="True"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0" x:Name="RowAttributeTable" MinHeight="0" MaxHeight="600"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#EAEAEA" x:Name="mapGrid">
                    <WindowsFormsHost x:Name="mapHost" />
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#E5E9ED" ShowsPreview="True" Cursor="SizeNS"/>

                <Border Grid.Row="2" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
                            <Grid Margin="15,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="查询结果属性表" FontWeight="SemiBold" Foreground="#444" VerticalAlignment="Center" Margin="0,0,30,0"/>
                                    <TextBlock Text="当前查询图层:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666"/>
                                    <ComboBox x:Name="cmbQueryLayers" DisplayMemberPath="Name" Width="180" Height="26" Background="White"/>
                                </StackPanel>

                                <Button Content="▼ 收起面板" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                        Background="Transparent" BorderThickness="0" Foreground="#666" Cursor="Hand" Click="BtnCloseAttributeTable_Click"/>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="dgSearchResults" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                                  Background="White" HeadersVisibility="Column" SelectionMode="Single"
                                  SelectionChanged="dgSearchResults_SelectionChanged" 
                              
                                  BorderThickness="0"
                                  RowHeight="28" AlternatingRowBackground="#FAFAFA"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="#003328" Foreground="#D6E4F0" BorderThickness="0">
            <StatusBarItem>
                <TextBlock Text="系统就绪" Margin="10,0"/>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#337868" Margin="5,4"/>
            <StatusBarItem>
                <TextBlock x:Name="txtStatusBar" Text="坐标系: CGCS2000 / Gauss-Kruger 3度带" Foreground="White" Opacity="0.9"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>