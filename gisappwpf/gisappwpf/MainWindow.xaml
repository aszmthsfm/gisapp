<Window x:Class="gisappwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIS空间数据工程管理系统" Height="768" Width="1366"
        WindowState="Maximized">

    <Grid Background="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#005A3C">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Image Source="Resources/whu_logo.png" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="武汉大学地图生产地理空间数据软件" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F4F7FB" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <Button x:Name="BtnAddShapefile" Content="➕ 导入 Shapefile" Background="White" BorderBrush="#CCC" 
                Height="30" Cursor="Hand" Click="BtnAddShapefile_Click" Margin="0,0,0,5"/>

                            <Button x:Name="BtnRemoveLayer" Content="➖ 移除选中图层" Background="White" BorderBrush="#CCC" 
                Height="30" Cursor="Hand" Click="BtnRemoveLayer_Click" Margin="0,0,0,5"/>

                            <Button x:Name="BtnExportMap" Content="💾 导出地图" Background="White" BorderBrush="#CCC" 
                Height="30" Cursor="Hand" Click="BtnExportMap_Click"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="lstLayers" Grid.Row="1" Margin="5" BorderThickness="0" Background="Transparent"
                             SelectionChanged="lstLayers_SelectionChanged" HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Click="LayerVisibility_Click" Tag="{Binding}"/>

                                    <Grid Width="16" Height="16" Margin="0,0,8,0">
                                        <Border Background="{Binding SymbolColor}" BorderBrush="#999" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShapeType}" Value="Polygon">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Rectangle Fill="{Binding SymbolColor}" Height="3" VerticalAlignment="Center">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShapeType}" Value="Polyline">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <Ellipse Fill="{Binding SymbolColor}" Stroke="#999" StrokeThickness="1" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShapeType}" Value="Point">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" Foreground="#333"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="mapGrid" Margin="2">

                <Border Background="#E5E5E5" BorderBrush="#DDD" BorderThickness="1">
                    <WindowsFormsHost x:Name="mapHost" />
                </Border>

                <Popup x:Name="MapToolbarPopup" IsOpen="True" AllowsTransparency="True" StaysOpen="True" 
                       PlacementTarget="{Binding ElementName=mapGrid}" Placement="Relative" 
                       HorizontalOffset="20" VerticalOffset="20">

                    <Border Background="#F4F7FB" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Padding="5">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
                        </Border.Effect>

                        <StackPanel Orientation="Vertical">
                            <Button x:Name="BtnPan" Content="🖐 平移" Width="70" Height="32" Margin="0,5" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnPan_Click"/>
                            <Button x:Name="BtnZoomIn" Content="🔍 放大" Width="70" Height="32" Margin="0,5" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnZoomIn_Click"/>
                            <Button x:Name="BtnZoomOut" Content="🔎 缩小" Width="70" Height="32" Margin="0,5" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnZoomOut_Click"/>
                            <Button x:Name="BtnFullExtent" Content="🌍 全图" Width="70" Height="32" Margin="0,5" Background="White" BorderThickness="0" Cursor="Hand" Click="BtnFullExtent_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TabControl Grid.Column="2" Margin="5" Background="White" BorderBrush="#DDD">

                <TabItem Header="属性查询" FontSize="14">
                    <StackPanel Margin="10">
                        <TextBlock Text="查询条件" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="建筑名称:"/>
                        <TextBox x:Name="txtSearchName" Margin="0,5,0,10" Height="25" VerticalContentAlignment="Center"/>

                        <Button x:Name="btnSearch" Content="查询" Background="#005A3C" Foreground="White" Height="30" BorderThickness="0" Cursor="Hand" Click="BtnSearch_Click"/>

                        <TextBlock Text="详细信息" FontWeight="Bold" Margin="0,15,0,5"/>
                        <Border BorderBrush="#EEE" BorderThickness="1" Background="#F9F9F9" CornerRadius="3">
                            <ListView x:Name="lstAttributes" Height="350" Background="Transparent" BorderThickness="0" SelectionChanged="lstAttributes_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="建筑名称" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                        <GridViewColumn Header="建筑类型" DisplayMemberBinding="{Binding Type}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="图层操作" FontSize="14">
                    <StackPanel Margin="10">
                        <TextBlock Text="图层状态" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtSelectedLayer" Text="当前未选中图层 (请在左侧点击)" Foreground="Red" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Button x:Name="btnOpenAttrTable" Content="📊 查看该图层属性表" Background="#4CAF50" Foreground="White" Height="35" BorderThickness="0" Cursor="Hand" Click="BtnOpenAttrTable_Click" Margin="0,0,0,20"/>

                        <TextBlock Text="更改图层颜色" FontWeight="Bold" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="R:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtR" Width="40" Text="255" VerticalContentAlignment="Center"/>
                            <TextBlock Text="G:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="txtG" Width="40" Text="0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="B:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="txtB" Width="40" Text="0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="btnApplyColor" Content="🎨 应用颜色到该图层" Background="#FF9800" Foreground="White" Height="35" BorderThickness="0" Cursor="Hand" Click="BtnApplyColor_Click" Margin="0,15,0,0"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatusBar" Text="坐标系: CGCS2000 / Gauss-Kruger 3度带" VerticalAlignment="Bottom" Margin="10" Foreground="#333"/>

                <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="5" Margin="5">
                    <ScrollViewer>
                        <TextBlock Text="[10:30:12] 系统启动成功..." Foreground="#666" Margin="5"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>