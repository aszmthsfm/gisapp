<Window x:Class="gisappwpf.AttributeQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="属性查询" Height="550" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="图层:" VerticalAlignment="Center" FontWeight="Bold" Width="40"/>
            <ComboBox x:Name="cmbLayer" Width="380" DisplayMemberPath="Name" SelectionChanged="cmbLayer_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="字段 (双击添加):" Margin="0,0,0,2"/>
                <ListBox x:Name="lstFields" Height="100" SelectionChanged="lstFields_SelectionChanged" MouseDoubleClick="lstFields_MouseDoubleClick"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="取值 (双击添加):" Margin="0,0,0,2"/>
                <ListBox x:Name="lstValues" Height="100" MouseDoubleClick="lstValues_MouseDoubleClick"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="表达式" Margin="0,0,0,10">
            <WrapPanel Margin="5">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="55"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Margin" Value="3"/>
                        <EventSetter Event="Click" Handler="OperatorBtn_Click"/>
                    </Style>
                </WrapPanel.Resources>
                <Button Content="="/>
                <Button Content="!="/>
                <Button Content="is"/>
                <Button Content="like"/>
                <Button Content=">"/>
                <Button Content="&lt;"/>
                <Button Content=">="/>
                <Button Content="&lt;="/>
                <Button Content="Or"/>
                <Button Content="Null"/>
                <Button Content="Not"/>
                <Button Content="And"/>
                <Button Content="In"/>
                <Button Content="_"/>
                <Button Content="%"/>
                <Button Content="''"/>
                <Button Content="Between" Width="65"/>
                <Button Content="空格" Click="BtnSpace_Click"/>
                <Button Content="清空" Click="BtnClear_Click"/>
            </WrapPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Select * From Table Where:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtExpression" Height="40" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#0078D7" BorderThickness="1,1,1,2"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Button x:Name="btnSearch" Content="查找" Width="80" Height="30" HorizontalAlignment="Left" Click="btnSearch_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" HorizontalAlignment="Right" Click="btnCancel_Click"/>
        </Grid>
    </Grid>
</Window>