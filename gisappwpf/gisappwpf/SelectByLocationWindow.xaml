<Window x:Class="gisappwpf.SelectByLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按位置选择 (空间查询)" Height="400" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="根据图层之间的空间拓扑关系选择要素：" Margin="0,0,0,15" Foreground="#666"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="1. 我想在以下图层中查找要素 (目标图层):" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbTargetLayer" Height="28" DisplayMemberPath="Name" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="2. 使用以下图层的范围作为参考 (源图层):" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbSourceLayer" Height="28" DisplayMemberPath="Name" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="3. 选择空间关系方法:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbMethod" Height="28" Background="White" SelectionChanged="cmbMethod_SelectionChanged">
                <ComboBoxItem Content="与源图层要素相交 (Intersects)" Tag="Intersects" IsSelected="True"/>
                <ComboBoxItem Content="源图层要素完全包含目标图层要素 (Contains)" Tag="Contains"/>
                <ComboBoxItem Content="目标图层要素在源图层要素范围内 (Within)"/>
                <ComboBoxItem Content="在源图层要素的距离范围内 (Distance) " Tag="Distance"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" x:Name="stackBuffer" Margin="0,0,0,15" Visibility="Collapsed">
            <TextBlock Text="4. 设置缓冲搜索距离 (单位: 米):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBufferDistance" Height="28" VerticalContentAlignment="Center" Text="100"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btnApply" Content="执行选择" Width="90" Height="30" Background="#005A3C" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="btnApply_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>